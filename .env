# =====================================================================
#  Televentas Fest · API — variables de entorno (archivo único)
# =====================================================================
#  ⚠️ NO escribas aquí contraseñas ni claves reales: este archivo se sube a GitHub.
#     · En tu PC funciona tal cual: los secretos vacíos usan claves de desarrollo automáticas.
#     · En producción (Railway) las claves reales van en el panel de variables del hosting,
#       que tiene prioridad sobre este archivo. Allí los secretos son OBLIGATORIOS.
#  Generar un secreto:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =====================================================================

PORT=4000
NODE_ENV=development

# Orígenes del FRONTEND permitidos (separados por coma, sin "/" final).
# En desarrollo también se aceptan solas las IP de tu red local (para probar desde el celular).
CORS_ORIGINS=http://localhost:3000

# ---------- Base de datos ----------
# Local (XAMPP). En producción usa DATABASE_URL (tiene prioridad), ej. en Railway: ${{MySQL.MYSQL_URL}}
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tvfrontera
DATABASE_URL=

# Carpeta persistente para fotos subidas y de verificación (vacío = carpeta del proyecto).
# En Railway: /data (el volumen)
DATA_DIR=

# ---------- Seguridad (SECRETOS: vacíos aquí, reales solo en el hosting) ----------
# Firma de las sesiones (mínimo 32 caracteres)
AUTH_SECRET=
# Compartido con la web para refrescar su caché al instante (MISMO valor en la web)
REVALIDATE_SECRET=

# Cookie de sesión. Producción con HTTPS: COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Saltos de proxy de confianza para la IP real del visitante (vacío = 1 en producción)
TRUST_PROXY=

# ---------- URLs públicas ----------
# Sitio (frontend): se usa en los enlaces de los correos
APP_URL=http://localhost:3000
# Desde dónde se sirven /uploads (fotos importadas de Facebook). En producción: el dominio del sitio
API_URL=http://localhost:4000

# ---------- Correo ----------
# Producción: RESEND_API_KEY (https://resend.com). Si está, se ignora el SMTP.
RESEND_API_KEY=
MAIL_FROM=TV Frontera <bosterion2018@gmail.com>
# Desarrollo con Gmail: SMTP_USER = tu cuenta y SMTP_PASS = contraseña de aplicación (16 letras).
# Si SMTP_PASS está vacío, en desarrollo los enlaces de los correos se muestran en la consola.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=bosterion2018@gmail.com
SMTP_PASS=

# ---------- Opciones del negocio ----------
# true = WhatsApp/teléfono/dirección de los aliados visibles sin iniciar sesión
CONTACTO_PUBLICO_ALIADOS=false
# true = solo cuentas con identidad verificada pueden ser Punto Aliado
EXIGIR_VERIFICACION_ALIADO=false

# ---------- Integraciones opcionales (vacío = desactivado) ----------
# Cloudflare Turnstile (anti-robots). La "site key" va en la web.
TURNSTILE_SECRET=
# Importar publicaciones de la página de Facebook como noticias
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_SYNC_MINUTOS=15
